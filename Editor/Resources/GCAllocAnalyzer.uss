/* ═══════════════════════════════════════════════════════════════════════════
   GC Alloc Analyzer — BarGraphElement style overrides
   Starts from package defaults, only overrides what's needed.
   ═══════════════════════════════════════════════════════════════════════════ */

.gc-alloc-bar-graph {
    /* Tighter bottom padding */
    --bar-graph-padding-bottom: 16;

    /* Dim unselected bars when selection is active */
    --bar-graph-dim-opacity: 0.3;

    /* Tag highlight — tint matching segments when an Allocation Site is selected */
    --bar-graph-tag-highlight-tint: rgba(255, 200, 50, 0.35);
    --bar-graph-tag-highlight-outline: rgba(255, 200, 50, 0.9);
    --bar-graph-tag-highlight-outline-width: 1.5;
}
